# Salin file ini menjadi .env lalu isi nilainya (JANGAN commit .env).

# Hub portofolio — pelaporan progres fase.
# HUB_INGEST_SECRET diambil dari .env repo "portofolio" (jangan ditulis di repo ini).
HUB_INGEST_URL=https://m-portofolio.hgteop.easypanel.host
HUB_INGEST_SECRET=

# Opsional (bila slug/nama proyek beda dari nama folder/package.json):
# HUB_PROJECT_SLUG=llmbepees-cl
# HUB_PROJECT_NAME=llmbepees-cl

# EasyPanel — deploy programatik (diisi saat Fase 5, JANGAN commit).
EASYPANEL_API_KEY=
